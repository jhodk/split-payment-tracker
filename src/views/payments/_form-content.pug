mixin paymentFormContent(isUpdate)
  - const userSplit = isUpdate ? payment.ledgerEntries.find(entry => entry.userId === user.id && entry.direction === 'CREDIT') : null
  - const otherUserSplit = isUpdate ? payment.ledgerEntries.find(entry => entry.userId === otherUser.id && entry.direction === 'CREDIT') : null
  - const userAmount = Number(userSplit?.amount ?? 0)
  - const otherUserAmount = Number(otherUserSplit?.amount ?? 0)
  - const totalAmount = isUpdate ? Number(payment.amount) : 0
  - const isFiftyFifty = isUpdate && userAmount > 0 && otherUserAmount > 0 && Math.abs(userAmount - otherUserAmount) <= 0.01
  - const isUserPaysAll = isUpdate && userAmount === totalAmount
  - const isOtherUserPaysAll = isUpdate && otherUserAmount === totalAmount

  div
    label(for="description") Description
    br
    input#description(
      type="text"
      name="description"
      value=isUpdate ? payment.description : ''
      required
    )

  script(type="module").
    import { inferCategory } from '#{toSiteUrl('/categoryHelper.js')}'

    document.querySelector('#description').addEventListener('input', (event) => {
      const categoryId = inferCategory(event.target.value)

      if (categoryId !== null) {
        document.querySelector('#category').value = String(categoryId)
      }
    })

  div
    label(for="amount") Amount
    br
    input#amount(
      type="number"
      name="amount"
      value=isUpdate ? payment.amount : 0
      min="0.01"
      step="0.01"
      required
    )
  
    div
      label(for="date") Date
      br
      input#date(
        type="date"
        name="date"
        value=isUpdate ? payment.date.toISOString().split('T')[0] : new Date().toISOString().split('T')[0]
      )

  label(for="category") Category
  br
  select#category(name="categoryId")
    each category in categories
      optgroup(label=category.name)
        each child in category.children
          option(value=child.id, selected=isUpdate ? child.id === payment.categoryId : false)= child.name


  div
    p Who paid?

    label
      input(
        type="radio"
        name="payerId"
        value=user.id
        checked=isUpdate ? payment.payerId === user.id : false
      )
      | #{user.name} (you)

    label
      input(
        type="radio"
        name="payerId"
        value=otherUser.id
        checked=isUpdate ? payment.payerId === otherUser.id : false
      )
      | #{otherUser.name}

  div
    p How should it be split?

    label
      input(
        type="radio"
        name="split"
        value="50-50"
        checked=isFiftyFifty
      )
      | 50 / 50

    label
      input(
        type="radio"
        name="split"
        value="100-0"
        checked=isUserPaysAll
      )
      | #{user.name} should pay 100%

    label
      input(
        type="radio"
        name="split"
        value="0-100"
        checked=isOtherUserPaysAll
      )
      | #{otherUser.name} should pay 100%