extends ../layout.pug
include _form-content.pug

block content
  a(href=toSiteUrl(`/payments#payment-${payment.id}`)) &lt; Back
  h1 Edit payment

  form(action=toSiteUrl(`/payments/${payment.id}/edit`) method="post")
    +paymentFormContent(true)
    br
    div
      a(href=`/payments/${payment.id}`) Cancel
      button(type="submit") Save changes
