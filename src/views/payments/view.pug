extends ../layout.pug

block content
  a(href='/payments') < Back to all payments
  div 
    img(src=prefixImageHost(payment.category.icon) alt=payment.category.name title=payment.category.name)
    br
    span #{payment.category.name}
  h1 #{payment.description}
  p £#{Number(payment.amount).toFixed(2)}
  p Added by #{payment.createdById === user.id ? "you" : otherUser.name} on #{payment.createdAt.toLocaleDateString('en-GB', {month: 'short',day: '2-digit', year: 'numeric'})}
  if payment.updatedAt
    p Updated by #{payment.updatedById === user.id ? "you" : otherUser.name} at #{payment.updatedAt.toISOString().slice(0, 19).replace('T', ' ') + ' UTC'}
  p #{payment.payerId === user.id ? "You" : otherUser.name} paid £#{Number(payment.amount).toFixed(2)}
  ul
    li You owe £#{Number(payment.splits.find(s => s.userId === user.id).amount).toFixed(2)}
    li #{otherUser.name} owes £#{Number(payment.splits.find(s => s.userId === otherUser.id).amount).toFixed(2)}

  br
  a(href=`/payments/${payment.id}/edit`) Edit
