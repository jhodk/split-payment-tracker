extends ../layout.pug

block content
  h1 #{groupName}

  if Number(summary.balance) > 0
    p #{summary.otherUserName} owes you £#{summary.balance}
  else if Number(summary.balance) < 0
    p You owe #{summary.otherUserName} £#{Math.abs(Number(summary.balance)).toFixed(2)}
  else
    p All settled

  a(href='/payments/create') Add payment
  br
  br

  - let lastCreatedMonthYear = undefined
  if payments.length
    ul.payments
      each payment in payments
        if lastCreatedMonthYear !== payment.createdAt.toLocaleDateString('en-GB', { month: 'long',  year: 'numeric'})
          //- skip first month/year label
          if lastCreatedMonthYear !== undefined
            p #{payment.createdAt.toLocaleDateString('en-GB', { month: 'long',  year: 'numeric'})}
          - lastCreatedMonthYear = payment.createdAt.toLocaleDateString('en-GB', { month: 'long',  year: 'numeric'})
        li.payment
          a(href=toSiteUrl(`/payments/${payment.id}`) id=`payment-${payment.id}`)
            div.payment-date
              span.payment-date-month= payment.date.split(' ')[0]
              span.payment-date-day= payment.date.split(' ')[1]

            img.payment-category-icon(
              src=prefixImageHost(payment.category.icon)
              alt=payment.category.name
              title=payment.category.name
            )

            div.payment-details
              span.payment-description= payment.description
              span.payment-payer
                | #{payment.payerId === userId ? 'You' : payment.payer.name} paid £#{payment.amount}

            if Number(payment.userBalance) > 0
              div.direction-details
                span.payment-balance.payment-lent you lent
                span.payment-balance-amount.payment-lent £#{payment.userBalance}

            else if Number(payment.userBalance) < 0
              div.direction-details
                span.payment-balance.payment-borrowed you borrowed
                span.payment-balance-amount.payment-borrowed £#{Math.abs(Number(payment.userBalance)).toFixed(2)}

            else
              span.direction-details
                | #{payment.payerId === userId ? 'You' : payment.payer.name} paid for #{payment.payerId === userId ? 'yourself' : 'themselves'}

  else
    p No payments yet.

  br
  a(href=toSiteUrl("/logout")) Log out