extends ../layout.pug

block content
  a(href='/payments') < Back to all payments
  h1 Add payment

  form(action="/payments" method="post")
    div
      label(for="description") Description
      br
      input#description(
        type="text"
        name="description"
        required
      )

    script(type="module").
      import { inferCategory } from '/categoryHelper.js'

      document.querySelector('#description').addEventListener('input', (event) => {
        const categoryId = inferCategory(event.target.value)

        if (categoryId !== null) {
          document.querySelector('#category').value = String(categoryId)
        }
      })

    div
      label(for="amount") Amount
      br
      input#amount(
        type="number"
        name="amount"
        min="0.01"
        step="0.01"
        required
      )

    label(for="category") Category
    br
    select#category(name="categoryId")
      each category in categories
        optgroup(label=category.name)
          each child in category.children
            option(value=child.id, selected= child.id === 18)= child.name

    div
      p Who paid?
      
      label
        input(
          type="radio"
          name="payerId"
          value=user.id
          checked
        )
        | #{user.name} (you)

      label
        input(
          type="radio"
          name="payerId"
          value=otherUser.id
        )
        | #{otherUser.name}

    div
      p How should it be split?

      label
        input(
          type="radio"
          name="split"
          value="50-50"
          checked
        )
        | 50 / 50

      label
        input(
          type="radio"
          name="split"
          value="100-0"
        )
        | #{user.name} pays 100%

      label
        input(
          type="radio"
          name="split"
          value="0-100"
        )
        | #{otherUser.name} pays 100%

    br
    a(href="/") Cancel
    button(type="submit") Add payment