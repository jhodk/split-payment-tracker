extends ../layout.pug
include _form-content.pug

block content
  - const backUrl = payment?.id !== undefined ? `/payments#payment-${payment.id}` : '/payments'

  a(href=backUrl) &lt; Back
  h1 Add payment

  form(action="/payments" method="post")
    +paymentFormContent(false)
    br
    a(href="/") Cancel
    button(type="submit") Add payment