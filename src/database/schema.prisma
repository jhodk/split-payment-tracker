generator client {
  provider        = "prisma-client"
  output          = "generated"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "mysql"
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String

  paymentsMade    Payment[]      @relation("PaymentPayer")
  paymentsCreated Payment[]      @relation("CreatedByUser")
  paymentsUpdated Payment[]      @relation("UpdatedByUser")
  splits          PaymentSplit[]
}

model Payment {
  id          Int     @id @default(autoincrement())
  description String
  amount      Decimal @db.Decimal(12, 2)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  payerId Int
  payer   User @relation("PaymentPayer", fields: [payerId], references: [id])

  createdAt   DateTime @default(now())
  createdById Int
  createdBy   User     @relation("CreatedByUser", fields: [createdById], references: [id])

  updatedAt   DateTime?
  updatedById Int?
  updatedBy   User?     @relation("UpdatedByUser", fields: [updatedById], references: [id])

  splits PaymentSplit[]
}

model PaymentSplit {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  @@unique([paymentId, userId])
}

model Category {
  id   Int    @id
  name String @unique
  icon String

  payments Payment[]
}
