generator client {
  provider        = "prisma-client"
  output          = "generated"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "mysql"
}

model User {
  id    Int    @id @default(autoincrement())
  email String
  name  String

  paymentsMade    Payment[]      @relation("PaymentPayer")
  paymentsCreated Payment[]      @relation("CreatedByUser")
  paymentsUpdated Payment[]      @relation("UpdatedByUser")
  ledgerEntries          LedgerEntry[]

  @@unique(email)
}

model Payment {
  id          Int     @id @default(autoincrement())
  description String
  amount      Decimal @db.Decimal(12, 2)
  categoryId Int
  payerId Int
  createdAt   DateTime @default(now())
  createdById Int
  updatedAt   DateTime?
  updatedById Int?

  category   Category @relation(fields: [categoryId], references: [id])
  payer   User @relation("PaymentPayer", fields: [payerId], references: [id])
  createdBy   User     @relation("CreatedByUser", fields: [createdById], references: [id])
  updatedBy   User?     @relation("UpdatedByUser", fields: [updatedById], references: [id])

  ledgerEntries LedgerEntry[]
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id Int @id @default(autoincrement())
  paymentId Int
  userId Int
  direction LedgerEntryType
  amount Decimal @db.Decimal(12, 2)

  payment   Payment @relation(fields: [paymentId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@unique([paymentId, userId, direction])
}

model Category {
  id   Int    @id
  name String
  icon String
  parentCategoryId Int?

  childCategories  Category[] @relation("CategoryHierarchy")
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  payments Payment[]

  @@unique([parentCategoryId, name])
}
